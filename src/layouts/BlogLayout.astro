---
import BaseLayout from "./BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title: string;
  description: string;
  date: string;
  dateFormatted: string;
  readTime: string;
  slug: string;
  headline: string;
  subtitle: string;
  gradientWord?: string;
}

const { title, description, date, dateFormatted, readTime, slug, headline, subtitle, gradientWord } = Astro.props;

const breadcrumbTitle = title.replace(" | RepairKeeper", "");

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://repairkeeper.co.uk" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://repairkeeper.co.uk/blog" },
    { "@type": "ListItem", position: 3, name: breadcrumbTitle, item: `https://repairkeeper.co.uk/blog/${slug}` },
  ],
};

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: headline,
  description: description,
  datePublished: date,
  author: { "@type": "Organization", name: "RepairKeeper" },
  publisher: { "@type": "Organization", name: "RepairKeeper", url: "https://repairkeeper.co.uk" },
};

// If gradientWord is provided, wrap that word in headline with gradient-text span
function renderHeadline(text: string, word?: string) {
  if (!word) return text;
  const idx = text.toLowerCase().indexOf(word.toLowerCase());
  if (idx === -1) return text;
  const before = text.slice(0, idx);
  const match = text.slice(idx, idx + word.length);
  const after = text.slice(idx + word.length);
  return `${before}<span class="gradient-text">${match}</span>${after}`;
}

const renderedHeadline = renderHeadline(headline, gradientWord);
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="hero-gradient relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-20">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-primary/10 blur-3xl animate-pulse-glow"></div>
        <div class="absolute -bottom-32 -left-32 h-80 w-80 rounded-full bg-accent/8 blur-3xl animate-pulse-glow" style="animation-delay: 1.5s;"></div>
      </div>
      <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="mb-6 flex items-center justify-center gap-2 text-sm text-slate-500" aria-label="Breadcrumb">
          <a href="/blog" class="transition-colors hover:text-primary">Blog</a>
          <svg class="h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
          <span class="truncate max-w-[280px] sm:max-w-none text-slate-400">{breadcrumbTitle}</span>
        </nav>
        <!-- Date pill -->
        <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-white/60 backdrop-blur-sm px-4 py-1.5 text-sm text-slate-600 shadow-sm ring-1 ring-slate-200/60">
          <time datetime={date}>{dateFormatted}</time>
          <span class="h-1 w-1 rounded-full bg-slate-400"></span>
          <span>{readTime}</span>
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-dark sm:text-4xl lg:text-5xl animate-fade-up" set:html={renderedHeadline} />
        <p class="mt-5 text-lg leading-relaxed text-slate-600 animate-fade-up" style="animation-delay: 0.15s;">
          {subtitle}
        </p>
      </div>
    </section>

    <!-- Article body -->
    <article class="py-20 sm:py-28">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="blog-prose">
          <slot />
        </div>
      </div>
    </article>

    <!-- Bottom CTA -->
    <section class="relative overflow-hidden bg-dark py-20 sm:py-28">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-primary/20 blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-accent/20 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <div class="reveal">
          <slot name="cta-text" />
          <a href="https://app.repairkeeper.co.uk/register" class="mt-8 inline-flex items-center gap-2 rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-light hover:shadow-xl hover:shadow-primary/30">
            Try RepairKeeper Free
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <p class="mt-4 text-sm text-slate-500">Free plan available — no credit card required.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
</BaseLayout>

<style is:global>
  /* Blog prose styling */
  .blog-prose h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-dark);
    margin-top: 3.5rem;
    margin-bottom: 1rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-primary);
    line-height: 1.3;
  }

  .blog-prose h2:first-child {
    margin-top: 0;
  }

  .blog-prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-dark);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .blog-prose p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #475569; /* slate-600 */
    margin-bottom: 1.25rem;
  }

  .blog-prose strong {
    color: var(--color-dark);
    font-weight: 600;
  }

  .blog-prose a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-primary);
    text-decoration-thickness: 1px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .blog-prose a:hover {
    color: var(--color-primary-dark);
    text-decoration-color: var(--color-primary-dark);
  }

  .blog-prose ul,
  .blog-prose ol {
    padding-left: 0;
    margin-bottom: 1.25rem;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .blog-prose ol {
    counter-reset: blog-counter;
  }

  .blog-prose ul li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #475569;
  }

  .blog-prose ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .blog-prose ol li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #475569;
    counter-increment: blog-counter;
  }

  .blog-prose ol li::before {
    content: counter(blog-counter) ".";
    position: absolute;
    left: 0;
    font-weight: 600;
    color: var(--color-primary);
  }

  .blog-prose blockquote {
    border-left: 4px solid rgba(79, 70, 229, 0.3);
    padding-left: 1.5rem;
    font-style: italic;
    color: #64748b; /* slate-500 */
    margin: 2rem 0;
  }

  .blog-prose blockquote p {
    color: inherit;
  }

  .blog-prose code {
    font-size: 0.9em;
    background: #f1f5f9;
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    color: var(--color-primary-dark);
  }

  /* Callout box */
  .blog-prose .callout {
    background: rgba(79, 70, 229, 0.05);
    border: 1px solid rgba(79, 70, 229, 0.1);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin: 2.5rem 0;
  }

  .blog-prose .callout p {
    color: var(--color-dark);
    font-weight: 500;
    margin-bottom: 0;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .blog-prose .callout p::before {
    content: "💡 ";
  }

  /* Section breathing — add extra space between h2 sections */
  .blog-prose h2 + p {
    margin-top: 0;
  }

  /* Subtle separator between major sections */
  .blog-prose h2::after {
    content: "";
    display: block;
    width: 3rem;
    height: 0;
    margin-top: 0;
  }
</style>
