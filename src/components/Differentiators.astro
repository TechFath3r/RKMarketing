---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";

const differentiators = [
  {
    icon: "ticket",
    title: "Multi-device tickets",
    description: "One ticket, multiple devices — each with independent statuses, parts, diagnosis, and costs. Most competitors treat a ticket as one device.",
  },
  {
    icon: "cpu",
    title: "Agent-ready API",
    description: "Connect AI agents, automation tools, or your own software directly to RepairKeeper. Full REST API with secure org-scoped keys — your shop, running on autopilot.",
  },
  {
    icon: "zap",
    title: "Intelligent auto-status",
    description: "Statuses advance automatically based on your parts workflow. Zero manual updates needed — the system always reflects reality.",
  },
  {
    icon: "refresh-cw",
    title: "Trade-in & refurbishment",
    description: "A complete buy-grade-refurbish-sell pipeline built in. Condition checklists, cost tracking, and margin scheme support.",
  },
  {
    icon: "wiki",
    title: "Global repair wiki",
    description: "A shared knowledge base across all shops on the platform. Devices, parts, faults, and guides — contributed by the community.",
  },
  {
    icon: "clipboard-list",
    title: "Diagnosis approval",
    description: "Share diagnoses with customers and let them approve or decline repairs from their tracking page — before any work begins.",
  },
  {
    icon: "calendar",
    title: "Online repair booking",
    description: "Customers book repairs on your website with service selection, date picking, and deposit payment — no phone calls required.",
  },
  {
    icon: "lock",
    title: "Passkey authentication",
    description: "Log in with fingerprint, Face ID, or security key — no password needed. Modern security with zero friction.",
  },
  {
    icon: "tracking",
    title: "Customer self-service",
    description: "Customers track repairs, approve diagnoses, accept quotes, and pay invoices from a single link. No app downloads needed.",
  },
  {
    icon: "shield",
    title: "Full audit trail",
    description: "Every change logged with before/after diffs, user attribution, and timestamps. Complete accountability for compliance.",
  },
  {
    icon: "customers",
    title: "Smart duplicate detection",
    description: "Automatically identifies duplicate customers using name and phone matching, with one-click field-by-field merge and GDPR anonymisation.",
  },
  {
    icon: "team",
    title: "Granular permissions",
    description: "11 permission flags per team member — not just 'admin or not'. Control exactly who can create invoices, delete tickets, or manage stock.",
  },
  {
    icon: "message-square",
    title: "Spam-protected forms",
    description: "Embed branded enquiry and booking forms on your website with built-in honeypot and time-trap spam protection.",
  },
];
---

<section class="py-20 sm:py-28 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal">
      <SectionHeading
        title="What makes RepairKeeper different"
        subtitle="Built from the ground up for repair shops — not retrofitted from generic helpdesk software."
        badge="Why RepairKeeper"
      />
    </div>

    <div class="reveal stagger grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {differentiators.map((item) => (
        <div class="text-center">
          <div class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-lg bg-primary/10 text-primary">
            <Icon name={item.icon} size={22} />
          </div>
          <h3 class="mb-1 text-sm font-semibold text-dark">{item.title}</h3>
          <p class="text-xs leading-relaxed text-slate-600">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
