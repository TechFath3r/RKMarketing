---
const featureLinks = [
  { label: "Repair Tickets", href: "/repair-ticket-software" },
  { label: "Quoting & Invoicing", href: "/repair-shop-invoicing-software" },
  { label: "Customer CRM", href: "/repair-shop-crm" },
  { label: "Inventory & Stock", href: "/repair-shop-inventory-software" },
  { label: "Online Booking", href: "/repair-booking-software" },
  { label: "Trade-In & Refurbishment", href: "/repair-shop-trade-in-software" },
  { label: "Team Management", href: "/repair-shop-team-management" },
  { label: "Repair Wiki", href: "/repair-wiki-software" },
];

const navLinks = [
  { label: "Pricing", href: "/pricing" },
  { label: "Blog", href: "/blog" },
  { label: "Changelog", href: "/changelog" },
];
---

<header class="fixed top-0 z-50 w-full border-b border-slate-200/60 bg-white/80 backdrop-blur-lg">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2" aria-label="RepairKeeper home">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
        </svg>
      </div>
      <span class="text-xl font-bold text-dark">
        Repair<span class="text-primary">Keeper</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
      <!-- Features dropdown -->
      <div class="relative" id="features-dropdown">
        <button
          type="button"
          class="nav-link inline-flex items-center gap-1 text-sm font-medium text-slate-600 transition-colors hover:text-primary"
          aria-expanded="false"
          aria-haspopup="true"
        >
          Features
          <svg class="h-4 w-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
        </button>
        <div class="features-menu pointer-events-none absolute left-1/2 top-full z-50 mt-2 w-56 -translate-x-1/2 rounded-xl border border-slate-200 bg-white p-2 opacity-0 shadow-lg transition-all">
          {featureLinks.map((link) => (
            <a href={link.href} class="block rounded-lg px-3 py-2 text-sm text-slate-600 transition-colors hover:bg-slate-50 hover:text-primary">
              {link.label}
            </a>
          ))}
          <div class="my-1 border-t border-slate-100"></div>
          <a href="/#features" class="block rounded-lg px-3 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary/5">
            All features
          </a>
        </div>
      </div>
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link text-sm font-medium text-slate-600 transition-colors hover:text-primary">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:block">
      <a
        href="https://app.repairkeeper.co.uk/register"
        class="inline-flex items-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-primary-dark hover:shadow-md"
      >
        Get Started Free
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="inline-flex items-center justify-center rounded-lg p-2 text-slate-600 transition-colors hover:bg-slate-100 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <line x1="4" x2="20" y1="6" y2="6" />
        <line x1="4" x2="20" y1="12" y2="12" />
        <line x1="4" x2="20" y1="18" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden border-t border-slate-200/60 bg-white md:hidden">
    <nav class="mx-auto max-w-7xl space-y-1 px-4 py-4" aria-label="Mobile navigation">
      <div class="px-4 py-1 text-xs font-semibold uppercase tracking-wider text-slate-400">Features</div>
      {featureLinks.map((link) => (
        <a
          href={link.href}
          class="block rounded-lg px-4 py-2.5 text-base font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-primary"
        >
          {link.label}
        </a>
      ))}
      <div class="my-2 border-t border-slate-100"></div>
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block rounded-lg px-4 py-2.5 text-base font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-primary"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-2">
        <a
          href="https://app.repairkeeper.co.uk/register"
          class="block rounded-lg bg-primary px-4 py-2.5 text-center text-base font-semibold text-white transition-colors hover:bg-primary-dark"
        >
          Get Started Free
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  // Features dropdown hover/click
  document.addEventListener("DOMContentLoaded", () => {
    const dropdown = document.getElementById("features-dropdown");
    if (!dropdown) return;
    const btn = dropdown.querySelector("button");
    const menu = dropdown.querySelector(".features-menu");
    if (!btn || !menu) return;

    let timeout;
    const show = () => { clearTimeout(timeout); menu.classList.add("opacity-100", "pointer-events-auto"); menu.classList.remove("opacity-0", "pointer-events-none"); btn.setAttribute("aria-expanded", "true"); };
    const hide = () => { timeout = setTimeout(() => { menu.classList.remove("opacity-100", "pointer-events-auto"); menu.classList.add("opacity-0", "pointer-events-none"); btn.setAttribute("aria-expanded", "false"); }, 150); };

    dropdown.addEventListener("mouseenter", show);
    dropdown.addEventListener("mouseleave", hide);
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      open ? hide() : show();
    });
  });
</script>
