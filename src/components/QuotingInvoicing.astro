---
import FeatureDetail from "./FeatureDetail.astro";
---

<section class="py-20 sm:py-28 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal">
      <FeatureDetail
        title="Professional quotes and invoices in minutes"
        subtitle="From quick estimates to formal quotes with customer approval, detailed invoices with partial payments, and Stripe checkout — every step of the money side, handled."
        badge="Quoting & Invoicing"
        reverse={true}
        items={[
          {
            icon: "file-text",
            title: "Formal quotes with customer approval",
            description: "Send professional quotes via email. Customers accept or decline from a unique link — with revision support and one-click convert to invoice."
          },
          {
            icon: "invoice",
            title: "Detailed invoices with PDF export",
            description: "Line items, discounts, VAT, custom messages and footers. Finalise to lock changes, then send by email with built-in reminders."
          },
          {
            icon: "credit-card",
            title: "Deposits & partial payments",
            description: "Collect deposits before work begins via Stripe. Track partial payments across multiple methods — cash, card, bank transfer, or online."
          },
          {
            icon: "pound",
            title: "Flexible VAT & pricing",
            description: "Configurable VAT rates for quotes and invoices. Set default labour rates, postage, and payment fees — override per document when needed."
          }
        ]}
      >
        <!-- Invoice mockup -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg">
          <div class="mb-4 flex items-center justify-between">
            <span class="text-sm font-semibold text-dark">Invoice #INV-0024</span>
            <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700">Paid</span>
          </div>
          <div class="space-y-2 border-b border-slate-100 pb-4 mb-4">
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-500">iPhone 15 Pro Screen</span>
              <span class="text-dark font-medium">&pound;79.99</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-500">Labour — Screen replacement</span>
              <span class="text-dark font-medium">&pound;25.00</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-500">Discount (10%)</span>
              <span class="text-red-500 font-medium">-&pound;10.50</span>
            </div>
          </div>
          <div class="flex items-center justify-between text-sm mb-1">
            <span class="text-slate-500">Subtotal</span>
            <span class="text-dark font-medium">&pound;94.49</span>
          </div>
          <div class="flex items-center justify-between text-sm mb-3">
            <span class="text-slate-500">VAT (20%)</span>
            <span class="text-dark font-medium">&pound;18.90</span>
          </div>
          <div class="flex items-center justify-between border-t border-slate-100 pt-3">
            <span class="text-sm font-semibold text-dark">Total</span>
            <span class="text-lg font-bold text-dark">&pound;113.39</span>
          </div>
          <div class="mt-4 flex gap-2">
            <div class="flex-1 rounded-lg bg-primary/5 p-2 text-center">
              <p class="text-xs text-slate-500">Deposit paid</p>
              <p class="text-sm font-semibold text-primary">&pound;30.00</p>
            </div>
            <div class="flex-1 rounded-lg bg-emerald-50 p-2 text-center">
              <p class="text-xs text-slate-500">Remaining</p>
              <p class="text-sm font-semibold text-emerald-600">&pound;83.39</p>
            </div>
          </div>
        </div>
      </FeatureDetail>
      <div class="mt-8 text-center lg:text-left">
        <a href="/repair-shop-invoicing-software" class="inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-primary-dark">
          Explore quoting and invoicing
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>
