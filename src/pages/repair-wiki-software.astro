---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Icon from "@components/Icon.astro";
import SectionHeading from "@components/SectionHeading.astro";
import FeatureDetail from "@components/FeatureDetail.astro";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://repairkeeper.co.uk" },
    { "@type": "ListItem", position: 2, name: "Repair Wiki & Knowledge Base Software", item: "https://repairkeeper.co.uk/repair-wiki-software" },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is a repair wiki?",
      acceptedAnswer: { "@type": "Answer", text: "A repair wiki is a searchable knowledge base of devices, parts, faults, and repair guides. RepairKeeper's wiki lets you build relationships between these — which parts fit which devices, which faults affect which devices, and which guides solve which faults — so your team can find answers fast." },
    },
    {
      "@type": "Question",
      name: "Can I share repair knowledge with other shops?",
      acceptedAnswer: { "@type": "Answer", text: "Yes. RepairKeeper includes a global sharing option. You can contribute your repair guides, device entries, and fault descriptions to a shared database visible to all RepairKeeper shops. You can also keep entries private to your organisation if you prefer." },
    },
    {
      "@type": "Question",
      name: "Can I import devices in bulk?",
      acceptedAnswer: { "@type": "Answer", text: "Yes. RepairKeeper supports bulk CSV import for devices. Upload a spreadsheet of your device catalogue and have them added to the wiki in seconds — no manual data entry required." },
    },
    {
      "@type": "Question",
      name: "Which plan includes the repair wiki?",
      acceptedAnswer: { "@type": "Answer", text: "The repair wiki and knowledge base is available on the Standard plan (£30/month) and above. The Standard plan also includes up to 5 team members, inventory management, asset tracking, label printing, and team management with RBAC." },
    },
    {
      "@type": "Question",
      name: "What types of resources can I attach to wiki entries?",
      acceptedAnswer: { "@type": "Answer", text: "You can attach links to videos, supplier pages, repair guides, forums, and documentation. Resources are linked to specific devices, parts, or faults so your team always has relevant reference material at their fingertips." },
    },
  ],
};
---

<BaseLayout
  title="Repair Wiki & Knowledge Base Software | RepairKeeper"
  description="Build a searchable knowledge base of devices, parts, faults, and repair guides. Share knowledge globally or keep it private. Built for repair shops."
>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="hero-gradient relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-20">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-primary/5 blur-3xl animate-pulse-glow"></div>
        <div class="absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-accent/5 blur-3xl animate-pulse-glow" style="animation-delay: 1.5s;"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary animate-fade-in">
          Repair Wiki
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-dark sm:text-5xl animate-fade-up" style="animation-delay: 0.15s;">
          A repair knowledge base that <span class="gradient-text">grows with your team</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 animate-fade-up" style="animation-delay: 0.3s;">
          Build a searchable database of devices, parts, faults, and repair guides — with relationships that connect them all. Share knowledge globally or keep it private to your shop.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4 animate-fade-up" style="animation-delay: 0.45s;">
          <a href="https://app.repairkeeper.co.uk/register" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-dark hover:shadow-xl hover:shadow-primary/30">
            Start 14-day free trial
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a href="/pricing" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-700 transition-all hover:border-primary/30 hover:text-primary">
            View Pricing
          </a>
        </div>
        <p class="mt-4 text-sm text-slate-500 animate-fade-up" style="animation-delay: 0.55s;">14-day free trial. Wiki features on Standard plan and above.</p>
      </div>
    </section>

    <!-- Searchable knowledge base -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <FeatureDetail
            title="Every device, part, and fault in one place"
            subtitle="Stop relying on tribal knowledge and scattered notes. RepairKeeper's wiki gives your whole team a single source of truth — searchable, structured, and always up to date."
            badge="Searchable Knowledge Base"
            items={[
              { icon: "search", title: "Instant search", description: "Find any device, part, fault, or repair guide in seconds. Search across your entire knowledge base from one search bar." },
              { icon: "link", title: "Relationship linking", description: "Connect parts to devices, faults to devices, and guides to faults. When a technician looks up a device, they see every related part, known fault, and repair guide." },
              { icon: "file-text", title: "Detailed entries", description: "Each wiki entry holds structured data — model numbers, specifications, common issues, compatible parts, and step-by-step repair procedures." },
              { icon: "download", title: "Bulk CSV import", description: "Upload your device catalogue via CSV. Import hundreds of devices in seconds instead of entering them one by one." },
            ]}
          >
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg">
              <div class="mb-4 flex items-center justify-between">
                <span class="text-sm font-semibold text-dark">Repair Wiki</span>
                <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">124 entries</span>
              </div>
              <div class="mb-3 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 flex items-center gap-2">
                <Icon name="search" size={14} />
                <span class="text-sm text-slate-400">Search devices, parts, faults&hellip;</span>
              </div>
              <div class="space-y-3">
                <div class="rounded-lg border border-slate-100 p-3">
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-dark">iPhone 15 Pro Max</span>
                    <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700">Device</span>
                  </div>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">8 parts</span>
                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">5 faults</span>
                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">3 guides</span>
                  </div>
                </div>
                <div class="rounded-lg border border-slate-100 p-3">
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-dark">Samsung Galaxy S24 OLED</span>
                    <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Part</span>
                  </div>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">Fits 2 devices</span>
                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">1 supplier</span>
                  </div>
                </div>
                <div class="rounded-lg border border-slate-100 p-3">
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-dark">No power after drop</span>
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">Fault</span>
                  </div>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">Affects 12 devices</span>
                    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">2 guides</span>
                  </div>
                </div>
              </div>
            </div>
          </FeatureDetail>
        </div>
      </div>
    </section>

    <!-- Global sharing -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <FeatureDetail
            title="Share knowledge across every repair shop"
            subtitle="RepairKeeper's global wiki means you don't have to start from scratch. Contribute your repair guides to the shared database and benefit from the knowledge of every other shop on the platform — or keep your entries private."
            badge="Global Sharing"
            reverse={true}
            items={[
              { icon: "globe", title: "Community knowledge", description: "Contribute devices, faults, and guides to a shared database visible to all RepairKeeper shops. The more shops contribute, the more valuable the wiki becomes." },
              { icon: "lock", title: "Private entries", description: "Not everything needs to be shared. Keep sensitive procedures, custom workflows, or proprietary techniques private to your organisation." },
              { icon: "users", title: "Team-wide access", description: "Every technician on your team can search and reference the wiki. New hires get up to speed faster with documented procedures and known faults." },
              { icon: "star", title: "Growing database", description: "The global wiki grows with the RepairKeeper community. Benefit from repair knowledge contributed by shops working on the same devices you service." },
            ]}
          >
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg">
              <div class="mb-4 flex items-center justify-between">
                <span class="text-sm font-semibold text-dark">Knowledge Sharing</span>
                <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Global</span>
              </div>
              <div class="space-y-3">
                <div class="rounded-lg border border-emerald-200 bg-emerald-50/50 p-3">
                  <div class="flex items-center gap-2">
                    <div class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                      <Icon name="globe" size={14} />
                    </div>
                    <span class="text-sm font-medium text-dark">iPhone 15 Screen Replacement Guide</span>
                  </div>
                  <p class="mt-1.5 ml-8 text-xs text-emerald-700">Shared globally &mdash; visible to all shops</p>
                  <p class="ml-8 text-xs text-slate-500">3 linked faults &middot; 2 video resources</p>
                </div>
                <div class="rounded-lg border border-blue-200 bg-blue-50/50 p-3">
                  <div class="flex items-center gap-2">
                    <div class="flex h-6 w-6 items-center justify-center rounded-full bg-blue-100 text-blue-600">
                      <Icon name="lock" size={14} />
                    </div>
                    <span class="text-sm font-medium text-dark">Custom Micro-Soldering Procedure</span>
                  </div>
                  <p class="mt-1.5 ml-8 text-xs text-blue-700">Private &mdash; your organisation only</p>
                  <p class="ml-8 text-xs text-slate-500">Internal procedure &middot; 1 video resource</p>
                </div>
                <div class="rounded-lg border border-emerald-200 bg-emerald-50/50 p-3">
                  <div class="flex items-center gap-2">
                    <div class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                      <Icon name="globe" size={14} />
                    </div>
                    <span class="text-sm font-medium text-dark">Samsung S24 Battery Fault Guide</span>
                  </div>
                  <p class="mt-1.5 ml-8 text-xs text-emerald-700">Shared globally &mdash; community contributed</p>
                  <p class="ml-8 text-xs text-slate-500">1 linked fault &middot; supplier link attached</p>
                </div>
              </div>
            </div>
          </FeatureDetail>
        </div>
      </div>
    </section>

    <!-- Resources & relationships -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <FeatureDetail
            title="Attach resources to any wiki entry"
            subtitle="Link videos, supplier pages, forum threads, documentation, and repair guides directly to devices, parts, and faults. Your technicians always have the right reference material at their fingertips."
            badge="Resource Attachments"
            items={[
              { icon: "link", title: "Videos & tutorials", description: "Attach YouTube links, internal training videos, and step-by-step visual guides to any device, part, or fault entry." },
              { icon: "globe", title: "Supplier pages", description: "Link directly to supplier product pages for fast part sourcing. Know exactly where to order from without searching every time." },
              { icon: "file-text", title: "Documentation & forums", description: "Attach manufacturer documentation, community forum threads, and technical specifications. Keep everything in context." },
              { icon: "tool", title: "Repair guides", description: "Write detailed step-by-step guides and link them to specific faults. When a technician encounters a known fault, the solution is already documented." },
            ]}
          >
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg">
              <div class="mb-4 flex items-center justify-between">
                <span class="text-sm font-semibold text-dark">Resources &mdash; iPhone 15 Pro Max</span>
                <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">6 resources</span>
              </div>
              <div class="space-y-2.5">
                <div class="flex items-center gap-3 rounded-lg border border-slate-100 p-2.5">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-red-100 text-red-600">
                    <Icon name="camera" size={14} />
                  </div>
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-dark truncate">Screen replacement walkthrough</p>
                    <p class="text-xs text-slate-500">YouTube &middot; 12:34</p>
                  </div>
                </div>
                <div class="flex items-center gap-3 rounded-lg border border-slate-100 p-2.5">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                    <Icon name="globe" size={14} />
                  </div>
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-dark truncate">OEM OLED screen &mdash; MobileParts UK</p>
                    <p class="text-xs text-slate-500">Supplier page &middot; &pound;42.99</p>
                  </div>
                </div>
                <div class="flex items-center gap-3 rounded-lg border border-slate-100 p-2.5">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-amber-600">
                    <Icon name="file-text" size={14} />
                  </div>
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-dark truncate">Apple technical service guide</p>
                    <p class="text-xs text-slate-500">Documentation &middot; PDF</p>
                  </div>
                </div>
                <div class="flex items-center gap-3 rounded-lg border border-slate-100 p-2.5">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-purple-100 text-purple-600">
                    <Icon name="message-square" size={14} />
                  </div>
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-dark truncate">GSM Forum &mdash; battery drain fix</p>
                    <p class="text-xs text-slate-500">Forum thread &middot; 47 replies</p>
                  </div>
                </div>
              </div>
            </div>
          </FeatureDetail>
        </div>
      </div>
    </section>

    <!-- Feature grid -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="Everything your repair wiki needs"
            subtitle="A structured knowledge base designed for how repair shops actually work."
          />
        </div>
        <div class="reveal stagger grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { icon: "smartphone", title: "Device catalogue", desc: "Build a complete catalogue of every device you repair — models, specifications, compatible parts, and known faults." },
            { icon: "tool", title: "Parts database", desc: "Track every part you use with compatibility data. Know which parts fit which devices without guessing." },
            { icon: "alert-triangle", title: "Fault library", desc: "Document common faults with descriptions, affected devices, and linked repair guides. Diagnose faster with a structured fault database." },
            { icon: "clipboard-list", title: "Step-by-step guides", desc: "Write detailed repair procedures with ordered steps. Link guides to specific faults so technicians find solutions instantly." },
            { icon: "download", title: "CSV device import", desc: "Upload your entire device catalogue via CSV. Import hundreds of entries in seconds — no manual data entry." },
            { icon: "tag", title: "Categorisation", desc: "Organise entries by type — devices, parts, faults, and guides. Filter and browse by category to find what you need." },
            { icon: "globe", title: "Global or private", desc: "Choose per entry: share with the RepairKeeper community or keep it private to your shop. Full control over visibility." },
            { icon: "refresh-cw", title: "Always growing", desc: "The wiki grows with your team and the community. Every repair you document makes the next one faster." },
          ].map((item) => (
            <div class="card-hover rounded-xl border border-slate-200 bg-white p-5">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name={item.icon} size={20} />
              </div>
              <h3 class="text-sm font-semibold text-dark">{item.title}</h3>
              <p class="mt-1 text-xs text-slate-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Related features -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading title="The wiki connects to your whole workflow" subtitle="Repair knowledge works alongside ticketing, inventory, and your team." />
        </div>
        <div class="reveal stagger grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { icon: "ticket", title: "Repair ticket software", desc: "Tickets reference wiki devices and parts. Technicians see known faults and repair guides right from the ticket.", href: "/repair-ticket-software" },
            { icon: "inventory", title: "Inventory & stock", desc: "Wiki parts link directly to your inventory. Know what's in stock when looking up a device or fault.", href: "/repair-shop-inventory-software" },
            { icon: "team", title: "Team management", desc: "Control who can edit the wiki with granular permissions. New team members get up to speed with documented knowledge.", href: "/repair-shop-team-management" },
          ].map((item) => (
            <a href={item.href} class="card-hover block rounded-xl border border-slate-200 bg-white p-6 transition-colors hover:border-primary/30">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name={item.icon} size={20} />
              </div>
              <h3 class="font-semibold text-dark">{item.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{item.desc}</p>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary">Learn more <Icon name="arrow-right" size={14} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading title="Repair wiki questions" badge="FAQ" />
        </div>
        <div class="reveal stagger space-y-3">
          {[
            { q: "What is a repair wiki?", a: "A repair wiki is a searchable knowledge base of devices, parts, faults, and repair guides. RepairKeeper's wiki lets you build relationships between these — which parts fit which devices, which faults affect which devices, and which guides solve which faults — so your team can find answers fast." },
            { q: "Can I share repair knowledge with other shops?", a: "Yes. RepairKeeper includes a global sharing option. You can contribute your repair guides, device entries, and fault descriptions to a shared database visible to all RepairKeeper shops. You can also keep entries private to your organisation if you prefer." },
            { q: "Can I import devices in bulk?", a: "Yes. RepairKeeper supports bulk CSV import for devices. Upload a spreadsheet of your device catalogue and have them added to the wiki in seconds — no manual data entry required." },
            { q: "Which plan includes the repair wiki?", a: "The repair wiki and knowledge base is available on the Standard plan (£30/month) and above. The Standard plan also includes up to 5 team members, inventory management, asset tracking, label printing, and team management with RBAC." },
            { q: "What types of resources can I attach to wiki entries?", a: "You can attach links to videos, supplier pages, repair guides, forums, and documentation. Resources are linked to specific devices, parts, or faults so your team always has relevant reference material at their fingertips." },
          ].map((item) => (
            <details class="group rounded-xl border border-slate-200 bg-white transition-all hover:border-primary/30">
              <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-left">
                <span class="pr-4 text-base font-semibold text-dark group-open:text-primary">{item.q}</span>
                <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180 group-open:text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
              </summary>
              <div class="px-6 pb-4">
                <p class="text-sm leading-relaxed text-slate-600">{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden bg-dark py-20 sm:py-28">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-primary/20 blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-accent/20 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <div class="reveal">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Stop losing repair knowledge when staff leave
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-400">
            RepairKeeper's wiki captures your team's expertise in a searchable database — devices, parts, faults, and guides all connected. Share with the community or keep it private. Start your 14-day free trial today.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href="https://app.repairkeeper.co.uk/register" class="inline-flex items-center gap-2 rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-light hover:shadow-xl hover:shadow-primary/30">
              Start 14-day free trial
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Card required &mdash; cancel any time before day 14 and you won't be charged. <a href="/pricing" class="text-primary-light hover:underline">See pricing</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
