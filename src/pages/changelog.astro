---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

// --- Read & parse changelog at build time ---
interface ChangelogItem {
  text: string;
}

interface ChangelogCategory {
  name: string;
  items: ChangelogItem[];
}

interface ChangelogEntry {
  date: string;
  categories: ChangelogCategory[];
}

let entries: ChangelogEntry[] = [];

const md = readFileSync(resolve("public/CHANGELOG.md"), "utf-8");

let currentEntry: ChangelogEntry | null = null;
let currentCategory: ChangelogCategory | null = null;

for (const line of md.split("\n")) {
  const trimmed = line.trim();

  // ## date heading
  if (trimmed.startsWith("## ")) {
    if (currentCategory && currentEntry) {
      currentEntry.categories.push(currentCategory);
    }
    if (currentEntry) {
      entries.push(currentEntry);
    }
    currentEntry = { date: trimmed.slice(3).trim(), categories: [] };
    currentCategory = null;
    continue;
  }

  // ### category heading
  if (trimmed.startsWith("### ")) {
    if (currentCategory && currentEntry) {
      currentEntry.categories.push(currentCategory);
    }
    currentCategory = { name: trimmed.slice(4).trim(), items: [] };
    continue;
  }

  // Bullet item
  if (trimmed.startsWith("- ") && currentCategory) {
    currentCategory.items.push({ text: trimmed.slice(2) });
  }
}

// Push final category and entry
if (currentCategory && currentEntry) {
  currentEntry.categories.push(currentCategory);
}
if (currentEntry) {
  entries.push(currentEntry);
}

// --- Category badge colours ---
const categoryColors: Record<string, { bg: string; text: string; border: string }> = {
  Tickets:          { bg: "bg-blue-50",    text: "text-blue-700",    border: "border-blue-200" },
  Invoices:         { bg: "bg-emerald-50", text: "text-emerald-700", border: "border-emerald-200" },
  Quotes:           { bg: "bg-amber-50",   text: "text-amber-700",   border: "border-amber-200" },
  Inventory:        { bg: "bg-purple-50",  text: "text-purple-700",  border: "border-purple-200" },
  "Repair Wiki":    { bg: "bg-cyan-50",    text: "text-cyan-700",    border: "border-cyan-200" },
  Emails:           { bg: "bg-pink-50",    text: "text-pink-700",    border: "border-pink-200" },
  Settings:         { bg: "bg-slate-100",  text: "text-slate-700",   border: "border-slate-300" },
  "Bug Fixes":      { bg: "bg-red-50",     text: "text-red-700",     border: "border-red-200" },
  "Label Printing": { bg: "bg-orange-50",  text: "text-orange-700",  border: "border-orange-200" },
  App:              { bg: "bg-indigo-50",   text: "text-indigo-700",  border: "border-indigo-200" },
  Plans:            { bg: "bg-violet-50",   text: "text-violet-700",  border: "border-violet-200" },
  "Warranty Returns": { bg: "bg-teal-50",  text: "text-teal-700",    border: "border-teal-200" },
};

const defaultColor = { bg: "bg-slate-100", text: "text-slate-700", border: "border-slate-300" };

function getColor(name: string) {
  return categoryColors[name] || defaultColor;
}

/** Convert **bold** markdown to <strong> tags */
function renderInline(text: string): string {
  return text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>").replace(/ — /g, " &mdash; ");
}

// --- JSON-LD ItemList ---
const jsonLdItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "RepairKeeper Changelog",
  description: "A chronological list of features and improvements shipped to RepairKeeper.",
  numberOfItems: entries.length,
  itemListElement: entries.map((entry, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: entry.date,
    description: entry.categories.map((c) => c.name).join(", "),
  })),
};
---

<BaseLayout
  title="Changelog — RepairKeeper | Latest Updates & Features"
  description="See everything shipped to RepairKeeper — new features, improvements, and fixes for your repair shop management software."
>
  <Header />

  <main id="main-content" class="pt-20">
    <!-- Sticky header -->
    <div class="sticky top-[57px] z-30 border-b border-slate-200/60 bg-white/90 backdrop-blur-lg">
      <div class="mx-auto max-w-4xl px-4 py-4 sm:px-6 lg:px-8">
        <h1 class="text-2xl font-bold text-dark sm:text-3xl">Changelog</h1>
        <p class="mt-1 text-sm text-slate-500">Everything shipped to RepairKeeper</p>
      </div>
    </div>

    <section class="py-12 sm:py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="relative">
            {/* Timeline line */}
            <div class="absolute left-[15px] top-2 bottom-2 hidden w-px bg-slate-200 sm:block" aria-hidden="true"></div>

            <div class="space-y-10">
              {entries.map((entry, entryIdx) => (
                <article class="reveal relative sm:pl-12">
                  {/* Timeline dot */}
                  <div class="absolute left-[10px] top-[6px] hidden h-[11px] w-[11px] rounded-full border-2 border-primary bg-white sm:block" aria-hidden="true"></div>

                  {/* Date heading */}
                  <div class="mb-4 flex items-center gap-3">
                    <time class="text-lg font-semibold text-dark sm:text-xl">{entry.date}</time>
                    {entryIdx === 0 && (
                      <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
                        Latest
                      </span>
                    )}
                  </div>

                  {/* Card */}
                  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                    <div class="space-y-5">
                      {entry.categories.map((cat) => {
                        const color = getColor(cat.name);
                        return (
                          <div>
                            <span class={`inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-semibold ${color.bg} ${color.text} ${color.border}`}>
                              {cat.name}
                            </span>
                            <ul class="mt-3 space-y-2.5">
                              {cat.items.map((item) => (
                                <li class="flex gap-2.5 text-sm leading-relaxed text-slate-600">
                                  <svg class="mt-1 h-4 w-4 shrink-0 text-primary/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 11 12 14 22 4" />
                                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                                  </svg>
                                  <span set:html={renderInline(item.text)} />
                                </li>
                              ))}
                            </ul>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
      </div>
    </section>
  </main>

  <Footer />

  {/* JSON-LD structured data */}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdItemList)} />
</BaseLayout>
