---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Icon from "@components/Icon.astro";
import SectionHeading from "@components/SectionHeading.astro";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://repairkeeper.co.uk" },
    { "@type": "ListItem", position: 2, name: "Best Repair Shop Software UK", item: "https://repairkeeper.co.uk/best-repair-shop-software-uk" },
  ],
};

const software = [
  {
    name: "RepairKeeper",
    recommended: true,
    tagline: "UK-built, purpose-built for independent repair shops",
    description: "RepairKeeper is a modern repair shop management platform designed from the ground up for UK independent repair businesses. It covers the full repair lifecycle — from customer enquiry through to invoicing and collection — in a single web app.",
    strengths: [
      "Multi-device tickets with independent statuses per device",
      "Intelligent auto-status engine driven by parts workflow",
      "Shared repair wiki and knowledge base across shops",
      "Customer self-service tracking page with online payments",
      "Stripe Connect integration for online invoice payments",
      "Digital intake and collection signatures",
      "Granular team permissions with full audit trail",
    ],
    considerations: [
      "Newer to market than some competitors",
      "Mobile app not yet available (fully responsive web app)",
    ],
    pricing: "Free plan (25 tickets/mo), Solo £12/mo, Lite £20/mo, Standard £30/mo, Pro £55/mo",
    bestFor: "Independent UK repair shops wanting a modern, all-in-one solution with a generous free tier",
    link: "https://repairkeeper.co.uk",
    icon: "star",
  },
  {
    name: "RepairDesk",
    recommended: false,
    tagline: "Established US-based platform with extensive integrations",
    description: "RepairDesk is a well-known name in the repair shop software space. Based in the US, it offers a broad feature set including POS capabilities, marketing tools, and a wide range of third-party integrations.",
    strengths: [
      "Wide integration ecosystem with third-party tools",
      "Built-in POS features for in-store transactions",
      "Marketing and SMS campaign tools",
      "Established user community and support resources",
    ],
    considerations: [
      "US-focused — pricing and features geared towards the American market",
      "Higher price point than many UK alternatives",
      "Can be complex to set up and configure fully",
    ],
    pricing: "Starts from around $99/mo (USD pricing)",
    bestFor: "Larger shops wanting extensive third-party integrations and POS features",
    link: null,
    icon: "globe",
  },
  {
    name: "RepairShopr (now Syncro)",
    recommended: false,
    tagline: "Strong brand, now focused on MSP and IT services",
    description: "RepairShopr was one of the original repair shop management tools and has since merged with Syncro to focus on managed service providers (MSPs) and IT service businesses. It still supports repair workflows but its development focus has shifted.",
    strengths: [
      "Strong brand recognition in the repair industry",
      "RMM and PSA integration for IT service providers",
      "Established user base with community resources",
      "Invoicing and CRM capabilities",
    ],
    considerations: [
      "Development focus has shifted towards the MSP market",
      "Less repair-shop-specific innovation in recent updates",
      "US-centric pricing in dollars",
    ],
    pricing: "Syncro plans start from $139/mo (USD pricing)",
    bestFor: "IT service providers and MSPs who also handle hardware repairs",
    link: null,
    icon: "tool",
  },
  {
    name: "My Gadget Repairs",
    recommended: false,
    tagline: "UK-based option with established local presence",
    description: "My Gadget Repairs is a UK-based repair shop management system that has been serving the local market for several years. It offers core repair tracking functionality with a focus on simplicity.",
    strengths: [
      "UK-based company with local support",
      "Longer market presence in the UK repair industry",
      "Straightforward interface for basic repair tracking",
    ],
    considerations: [
      "Smaller feature set compared to newer platforms",
      "Less frequent feature updates",
    ],
    pricing: "Contact for pricing",
    bestFor: "Shops wanting a simple, established UK-based option for basic repair tracking",
    link: null,
    icon: "map-pin",
  },
  {
    name: "Fixably",
    recommended: false,
    tagline: "Enterprise-grade repair management for large operations",
    description: "Fixably targets larger repair operations and authorised service providers. It offers enterprise-level features designed for high-volume repair centres and multi-location businesses.",
    strengths: [
      "Enterprise-grade features for large-scale operations",
      "Designed for authorised service provider workflows",
      "Multi-location support built for scale",
      "Strong reporting and analytics capabilities",
    ],
    considerations: [
      "Pricing not publicly listed — requires enterprise sales process",
      "Overkill for small independent repair shops",
      "Longer onboarding and setup process",
    ],
    pricing: "Custom pricing (enterprise sales process)",
    bestFor: "Large repair operations, authorised service providers, and multi-location businesses",
    link: null,
    icon: "bar-chart",
  },
];

const comparisonFeatures = [
  { feature: "Multi-device tickets", rk: true, rd: false, rs: false, mg: false, fx: false },
  { feature: "Auto-status engine", rk: true, rd: false, rs: false, mg: false, fx: false },
  { feature: "Online booking / enquiry form", rk: true, rd: true, rs: true, mg: true, fx: true },
  { feature: "Inventory management", rk: true, rd: true, rs: true, mg: true, fx: true },
  { feature: "Customer tracking page", rk: true, rd: true, rs: false, mg: false, fx: true },
  { feature: "Stripe payments", rk: true, rd: false, rs: false, mg: false, fx: false },
  { feature: "Repair wiki / knowledge base", rk: true, rd: false, rs: false, mg: false, fx: false },
  { feature: "Team management & RBAC", rk: true, rd: true, rs: true, mg: false, fx: true },
  { feature: "Free plan available", rk: true, rd: false, rs: false, mg: false, fx: false },
  { feature: "UK-based", rk: true, rd: false, rs: false, mg: true, fx: false },
];
---

<BaseLayout
  title="Best Repair Shop Software UK (2026) — Compared & Reviewed | RepairKeeper"
  description="Compare the best repair shop software in the UK for 2026. Features, pricing, and honest reviews of RepairKeeper, RepairDesk, RepairShopr, and more."
>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="hero-gradient relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-20">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-primary/5 blur-3xl animate-pulse-glow"></div>
        <div class="absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-accent/5 blur-3xl animate-pulse-glow" style="animation-delay: 1.5s;"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary animate-fade-in">
          Comparison
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-dark sm:text-5xl animate-fade-up" style="animation-delay: 0.15s;">
          Best repair shop software <span class="gradient-text">in the UK</span> (2026)
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 animate-fade-up" style="animation-delay: 0.3s;">
          Choosing the right repair shop management software can transform how you run your business. We have compared the leading options to help UK repair shops find the best fit.
        </p>
      </div>
    </section>

    <!-- Intro -->
    <section class="py-16 sm:py-20 bg-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="prose prose-slate max-w-none">
            <p class="text-lg leading-relaxed text-slate-600">
              The UK repair industry continues to grow as consumers and businesses look to extend the life of their electronics. Whether you run a phone repair shop on the high street or a multi-technician computer service centre, the right software makes all the difference — helping you track jobs, manage parts, communicate with customers, and get paid faster.
            </p>
            <p class="mt-4 text-lg leading-relaxed text-slate-600">
              When evaluating repair shop software, UK businesses should consider: <strong>pricing in GBP</strong>, <strong>UK-based support</strong>, <strong>VAT handling</strong>, <strong>feature depth</strong>, <strong>ease of setup</strong>, and whether the platform is actively developed with repair shops in mind. Here is our honest comparison of the top options available in 2026.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Software entries -->
    <section class="py-16 sm:py-24 bg-slate-50">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="The top repair shop software options"
            subtitle="An honest look at the leading platforms for UK repair businesses in 2026."
          />
        </div>
        <div class="reveal stagger space-y-8">
          {software.map((item, index) => (
            <div class={`card-hover rounded-2xl border bg-white p-6 sm:p-8 ${item.recommended ? 'border-primary/40 ring-2 ring-primary/10' : 'border-slate-200'}`}>
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                  <div class={`flex h-12 w-12 items-center justify-center rounded-xl ${item.recommended ? 'bg-primary/10 text-primary' : 'bg-slate-100 text-slate-500'}`}>
                    <Icon name={item.icon} size={24} />
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="text-xl font-bold text-dark">{item.name}</h3>
                      {item.recommended && (
                        <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary">Our Pick</span>
                      )}
                    </div>
                    <p class="text-sm text-slate-500">{item.tagline}</p>
                  </div>
                </div>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-600">#{index + 1}</span>
              </div>

              <p class="mt-4 text-slate-600 leading-relaxed">{item.description}</p>

              <div class="mt-6 grid gap-6 sm:grid-cols-2">
                <div>
                  <h4 class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-dark">
                    <Icon name="check" size={16} />
                    Key strengths
                  </h4>
                  <ul class="space-y-1.5">
                    {item.strengths.map((s: string) => (
                      <li class="flex items-start gap-2 text-sm text-slate-600">
                        <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" /></svg>
                        {s}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-dark">
                    <Icon name="alert-triangle" size={16} />
                    Things to consider
                  </h4>
                  <ul class="space-y-1.5">
                    {item.considerations.map((c: string) => (
                      <li class="flex items-start gap-2 text-sm text-slate-600">
                        <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 8v4" /><path d="M12 16h.01" /></svg>
                        {c}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-slate-100 pt-4">
                <div class="text-sm">
                  <span class="font-semibold text-dark">Pricing:</span>
                  <span class="ml-1 text-slate-600">{item.pricing}</span>
                </div>
                <div class="text-sm">
                  <span class="font-semibold text-dark">Best for:</span>
                  <span class="ml-1 text-slate-600">{item.bestFor}</span>
                </div>
              </div>

              {item.recommended && (
                <div class="mt-5">
                  <a href="https://app.repairkeeper.co.uk/register" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-dark hover:shadow-xl hover:shadow-primary/30">
                    Try RepairKeeper Free
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Comparison Table -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="Feature comparison"
            subtitle="A side-by-side look at the features that matter most for UK repair shops."
          />
        </div>
        <div class="reveal overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
          <table class="w-full min-w-[640px] text-sm">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50">
                <th class="px-4 py-3.5 text-left font-semibold text-dark">Feature</th>
                <th class="px-3 py-3.5 text-center font-semibold text-primary">RepairKeeper</th>
                <th class="px-3 py-3.5 text-center font-semibold text-dark">RepairDesk</th>
                <th class="px-3 py-3.5 text-center font-semibold text-dark">RepairShopr</th>
                <th class="px-3 py-3.5 text-center font-semibold text-dark">My Gadget Repairs</th>
                <th class="px-3 py-3.5 text-center font-semibold text-dark">Fixably</th>
              </tr>
            </thead>
            <tbody>
              {comparisonFeatures.map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                  <td class="px-4 py-3 font-medium text-dark">{row.feature}</td>
                  <td class="px-3 py-3 text-center">
                    {row.rk ? (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                        <Icon name="check" size={14} />
                      </span>
                    ) : (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                        <Icon name="x" size={14} />
                      </span>
                    )}
                  </td>
                  <td class="px-3 py-3 text-center">
                    {row.rd ? (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                        <Icon name="check" size={14} />
                      </span>
                    ) : (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                        <Icon name="x" size={14} />
                      </span>
                    )}
                  </td>
                  <td class="px-3 py-3 text-center">
                    {row.rs ? (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                        <Icon name="check" size={14} />
                      </span>
                    ) : (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                        <Icon name="x" size={14} />
                      </span>
                    )}
                  </td>
                  <td class="px-3 py-3 text-center">
                    {row.mg ? (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                        <Icon name="check" size={14} />
                      </span>
                    ) : (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                        <Icon name="x" size={14} />
                      </span>
                    )}
                  </td>
                  <td class="px-3 py-3 text-center">
                    {row.fx ? (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                        <Icon name="check" size={14} />
                      </span>
                    ) : (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                        <Icon name="x" size={14} />
                      </span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-center text-xs text-slate-400">Feature availability based on publicly available information as of March 2026. Contact individual providers for the latest details.</p>
      </div>
    </section>

    <!-- How we chose -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="How we evaluated each platform"
            subtitle="The criteria that matter most when choosing repair shop software for a UK business."
            badge="Methodology"
          />
        </div>
        <div class="reveal stagger grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { icon: "pound", title: "UK pricing & VAT", desc: "Is the software priced in GBP? Does it handle UK VAT correctly? Currency and tax support matters for day-to-day use." },
            { icon: "ticket", title: "Repair-specific features", desc: "Does it go beyond generic job management? Multi-device tickets, parts tracking, and repair-specific workflows separate the best from the rest." },
            { icon: "zap", title: "Ease of setup", desc: "Can you get started quickly without a lengthy onboarding process? A steep learning curve costs time and money." },
            { icon: "tracking", title: "Customer experience", desc: "Does it offer customer-facing features like tracking pages and online payments? Your customers expect transparency." },
            { icon: "inventory", title: "Inventory management", desc: "Can it track parts across locations, manage suppliers, and automatically allocate stock to tickets?" },
            { icon: "shield", title: "Security & reliability", desc: "Is data encrypted? Are there proper access controls? Can you audit who did what? Security is non-negotiable." },
          ].map((item) => (
            <div class="card-hover rounded-xl border border-slate-200 bg-white p-5">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name={item.icon} size={20} />
              </div>
              <h3 class="text-sm font-semibold text-dark">{item.title}</h3>
              <p class="mt-1 text-xs text-slate-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden bg-dark py-20 sm:py-28">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-primary/20 blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-accent/20 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <div class="reveal">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Try RepairKeeper free today
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-400">
            Join UK repair shops already using RepairKeeper to manage tickets, track parts, and get paid faster. Start with 25 free tickets per month — no credit card required.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href="https://app.repairkeeper.co.uk/register" class="inline-flex items-center gap-2 rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-light hover:shadow-xl hover:shadow-primary/30">
              Get Started Free
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
            <a href="/pricing" class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-transparent px-6 py-3.5 text-base font-semibold text-white transition-all hover:border-slate-400">
              View Pricing
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            No credit card required. <a href="/pricing" class="text-primary-light hover:underline">See all plans</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</BaseLayout>
