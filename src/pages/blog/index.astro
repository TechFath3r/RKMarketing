---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SectionHeading from "@components/SectionHeading.astro";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://repairkeeper.co.uk" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://repairkeeper.co.uk/blog" },
  ],
};

const posts = [
  {
    slug: "ai-agents-repair-shop",
    title: "Your repair shop, run by AI agents",
    description: "AI agents are becoming the operating system for modern businesses. Here's how repair shops can connect them directly to RepairKeeper — and what that actually means in practice.",
    date: "2026-04-01",
    readTime: "8 min read",
  },
  {
    slug: "how-to-manage-phone-repair-shop",
    title: "How to manage a phone repair shop: the complete workflow",
    description: "A practical guide to running a phone repair shop — from customer intake to device collection. Covers ticketing, parts management, communication, and getting paid.",
    date: "2026-03-20",
    readTime: "10 min read",
  },
  {
    slug: "repair-shop-inventory-management-guide",
    title: "Repair shop inventory management: a practical guide",
    description: "How to track parts, manage suppliers, and avoid stock-outs in a repair business. Covers multi-location stock, reorder points, and audit trails.",
    date: "2026-03-20",
    readTime: "8 min read",
  },
  {
    slug: "multi-device-repair-tickets",
    title: "Multi-device repair tickets: why they matter",
    description: "Most repair software treats a ticket as one device. Here's why multi-device tickets with independent statuses change how repair shops work.",
    date: "2026-03-20",
    readTime: "7 min read",
  },
];
---

<BaseLayout
  title="Blog — RepairKeeper | Repair Shop Guides & Insights"
  description="Practical guides and insights for running a repair shop. Workflow tips, inventory management, pricing strategies, and more."
>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="hero-gradient relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-20">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-primary/5 blur-3xl animate-pulse-glow"></div>
        <div class="absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-accent/5 blur-3xl animate-pulse-glow" style="animation-delay: 1.5s;"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary animate-fade-in">
          Blog
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-dark sm:text-5xl animate-fade-up" style="animation-delay: 0.15s;">
          Guides for running a <span class="gradient-text">better repair shop</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 animate-fade-up" style="animation-delay: 0.3s;">
          Practical advice on workflows, inventory, pricing, and tools — written for repair shop owners and technicians.
        </p>
      </div>
    </section>

    <!-- Posts -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="reveal stagger space-y-8">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="card-hover block rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 transition-colors hover:border-primary/30">
              <div class="flex items-center gap-3 text-sm text-slate-500 mb-3">
                <time datetime={post.date}>{new Date(post.date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</time>
                <span>&middot;</span>
                <span>{post.readTime}</span>
              </div>
              <h2 class="text-xl font-bold text-dark sm:text-2xl">{post.title}</h2>
              <p class="mt-2 text-slate-600 leading-relaxed">{post.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary">
                Read article
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden bg-dark py-20 sm:py-28">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-primary/20 blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-accent/20 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <div class="reveal">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Ready to put this into practice?
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-400">
            RepairKeeper gives you the tools to run your repair shop properly — tickets, inventory, invoicing, and more. Every plan starts with a 14-day free trial.
          </p>
          <div class="mt-8">
            <a href="https://app.repairkeeper.co.uk/register" class="inline-flex items-center gap-2 rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-light hover:shadow-xl hover:shadow-primary/30">
              Start 14-day free trial
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</BaseLayout>
