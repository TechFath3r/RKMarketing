<BaseLayout title="Repair shop inventory management: a practical guide | RepairKeeper" description="How to track parts, manage suppliers, and avoid stock-outs in a repair business. Covers multi-location stock, reorder points, and audit trails.">
  <Header />
  <main id="main-content">
    <section class="hero-gradient relative overflow-hidden pt-28 pb-12 sm:pt-36 sm:pb-16">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
