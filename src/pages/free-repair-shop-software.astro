---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Icon from "@components/Icon.astro";
import SectionHeading from "@components/SectionHeading.astro";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://repairkeeper.co.uk" },
    { "@type": "ListItem", position: 2, name: "Free Repair Shop Software", item: "https://repairkeeper.co.uk/free-repair-shop-software" },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Does RepairKeeper offer free repair shop software?",
      acceptedAnswer: { "@type": "Answer", text: "RepairKeeper offers a 14-day free trial on every paid plan — Solo (£12/mo), Lite (£20/mo), Standard (£30/mo), and Pro (£55/mo). A card is required at signup and you can cancel any time before day 14 to avoid being charged. Shops that signed up on the original free plan before it was retired remain on it and are grandfathered in." },
    },
    {
      "@type": "Question",
      name: "Is the 14-day free trial really free?",
      acceptedAnswer: { "@type": "Answer", text: "Yes. You pay nothing for 14 days. A payment card is required at signup so billing can begin automatically on day 15 if you decide to continue. Cancel any time during the trial and no charge is taken." },
    },
    {
      "@type": "Question",
      name: "Why was the free forever plan retired for new signups?",
      acceptedAnswer: { "@type": "Answer", text: "The old free plan drew signups that never activated a real shop, which diluted the product focus. A 14-day trial on paid plans means new shops get full access to the feature set they will actually use day to day — including the Solo plan at £12/mo with 75 tickets per month, which is larger than the old free plan's 25-ticket cap." },
    },
    {
      "@type": "Question",
      name: "I already have a free account — do I lose it?",
      acceptedAnswer: { "@type": "Answer", text: "No. Every shop that was on the free plan before it was retired is grandfathered in and keeps the free plan indefinitely, with the same 25 tickets per month, 1 team member, and core feature set. You can upgrade to a paid plan at any time if your shop outgrows it." },
    },
    {
      "@type": "Question",
      name: "What is the cheapest paid plan?",
      acceptedAnswer: { "@type": "Answer", text: "Solo is £12/mo and includes 75 tickets per month — three times the old free plan's allowance — with core ticketing, invoicing, customer tracking pages, digital signatures, and auto-status automation. It starts with a 14-day free trial like every other paid plan." },
    },
  ],
};
---

<BaseLayout
  title="Free Repair Shop Software — 14-Day Free Trial on Every Plan | RepairKeeper"
  description="Try RepairKeeper free for 14 days — every paid plan starts with a 14-day free trial. Full ticket management, invoicing, and customer tracking from £12/mo. UK-built."
>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="hero-gradient relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-20">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-primary/5 blur-3xl animate-pulse-glow"></div>
        <div class="absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-accent/5 blur-3xl animate-pulse-glow" style="animation-delay: 1.5s;"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary animate-fade-in">
          Try Free for 14 Days
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-dark sm:text-5xl animate-fade-up" style="animation-delay: 0.15s;">
          Try RepairKeeper <span class="gradient-text">free for 14 days</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 animate-fade-up" style="animation-delay: 0.3s;">
          Every paid plan starts with a 14-day free trial — full access to ticket management, invoicing, customer tracking, and everything else in the plan you pick. Card required at signup. Cancel any time before day 14.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4 animate-fade-up" style="animation-delay: 0.45s;">
          <a href="https://app.repairkeeper.co.uk/register" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-dark hover:shadow-xl hover:shadow-primary/30">
            Start 14-day free trial
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a href="/pricing" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-700 transition-all hover:border-primary/30 hover:text-primary">
            Compare All Plans
          </a>
        </div>
        <p class="mt-4 text-sm text-slate-500 animate-fade-up" style="animation-delay: 0.55s;">Card required at signup. Cancel before day 14 to avoid any charge. Plans from £12/mo.</p>
      </div>
    </section>

    <!-- How the trial works -->
    <section class="py-16 sm:py-20 bg-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="prose prose-slate max-w-none">
            <p class="text-lg leading-relaxed text-slate-600">
              If you are searching for <strong>free repair shop software</strong>, here is the honest picture. RepairKeeper no longer offers a free-forever tier to new signups — but <strong>every paid plan starts with a 14-day free trial</strong> so you can run a real shop on it, test every feature you will actually use, and only commit to paying if the product earns it.
            </p>
            <p class="mt-4 text-lg leading-relaxed text-slate-600">
              The trial is a genuine no-cost evaluation: you pick a plan, pay nothing for 14 days, and get the full feature set for that plan. A payment card is captured at signup so billing can start automatically on day 15 if you continue. Cancel any time during the trial from your dashboard and you will not be charged.
            </p>
            <p class="mt-4 text-lg leading-relaxed text-slate-600">
              Shops already on the original free plan from before it was retired are <strong>grandfathered in</strong> and keep it indefinitely. If that is you, nothing changes.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What the trial includes -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="What's included during your 14-day trial"
            subtitle="You get the full feature set of whichever plan you pick. No stripped-down demo, no hidden limits."
            badge="Full access"
          />
        </div>
        <div class="reveal stagger grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { icon: "ticket", title: "Full ticket management", desc: "Create unlimited tickets during the trial. Each ticket supports multiple devices, full fault descriptions, accessories, passcodes, and independent per-device statuses." },
            { icon: "customers", title: "Customer management", desc: "Full customer profiles with contact details, repair history, and notes. Smart duplicate detection and merge included." },
            { icon: "invoice", title: "Quoting & invoicing", desc: "Create detailed quotes and professional invoices with line items, VAT support, and PDF export. Email invoices directly to customers." },
            { icon: "tracking", title: "Customer tracking page", desc: "Every ticket generates a unique tracking link. Customers check repair status in real time without calling you." },
            { icon: "camera", title: "Digital signatures", desc: "Capture intake and collection signatures on screen. A clear record of what was agreed and when the device changed hands." },
            { icon: "zap", title: "Auto-status engine", desc: "Intelligent status automation — device statuses advance based on your parts workflow. The ticket status always reflects reality." },
            { icon: "inventory", title: "Inventory (Standard & Pro)", desc: "Track stock across multiple locations, manage suppliers, auto-allocate parts to tickets, and see stock demand at a glance." },
            { icon: "wiki", title: "Repair wiki (Standard & Pro)", desc: "Searchable knowledge base of devices, parts, faults, and repair guides. Share globally across all shops or keep entries private." },
            { icon: "users", title: "Team & permissions (Standard & Pro)", desc: "Invite team members with granular role-based access control. Full audit log of every create, update, and delete." },
          ].map((item) => (
            <div class="card-hover rounded-xl border border-slate-200 bg-white p-6">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name={item.icon} size={20} />
              </div>
              <h3 class="font-semibold text-dark">{item.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Plan selection -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="Pick a plan — then try it free for 14 days"
            subtitle="You can switch or cancel any time during the trial. After day 14, billing starts automatically at the plan you chose."
          />
        </div>
        <div class="reveal stagger grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { name: "Solo", price: "£12", tagline: "Best for solo technicians", features: ["75 tickets/mo", "1 team member", "Core ticketing & invoicing", "Customer tracking page", "Auto-status engine"], highlight: false },
            { name: "Lite", price: "£20", tagline: "For growing sole traders", features: ["150 tickets/mo", "1 team member", "Online booking", "Trade-in & refurbishment", "Custom SMTP"], highlight: false },
            { name: "Standard", price: "£30", tagline: "For small teams", features: ["Unlimited tickets", "5 team members", "Inventory & wiki", "Team permissions & audit log", "Branded labels"], highlight: true },
            { name: "Pro", price: "£55", tagline: "For established shops", features: ["Unlimited tickets", "15 team members", "Everything in Standard", "Branding removal", "Priority support"], highlight: false },
          ].map((plan) => (
            <div class={`rounded-2xl border bg-white p-6 ${plan.highlight ? 'border-primary/40 ring-2 ring-primary/10 shadow-lg' : 'border-slate-200'}`}>
              {plan.highlight && (
                <span class="mb-3 inline-block rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary">Most popular</span>
              )}
              <h3 class="text-lg font-bold text-dark">{plan.name}</h3>
              <p class="text-xs text-slate-500">{plan.tagline}</p>
              <div class="mt-3 flex items-baseline gap-1">
                <span class="text-3xl font-extrabold text-dark">{plan.price}</span>
                <span class="text-sm text-slate-500">/mo</span>
              </div>
              <p class="mt-1 text-xs font-medium text-primary">14-day free trial</p>
              <ul class="mt-4 space-y-1.5">
                {plan.features.map((f: string) => (
                  <li class="flex items-start gap-2 text-sm text-slate-600">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" /></svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-6 text-center text-xs text-slate-400">All prices in GBP. Monthly and yearly billing available. <a href="/pricing" class="text-primary hover:underline">See full pricing details</a>.</p>
      </div>
    </section>

    <!-- Grandfathered -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="rounded-2xl border border-primary/30 bg-white p-8 shadow-sm">
            <div class="flex items-center gap-3 mb-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name="shield" size={20} />
              </div>
              <h2 class="text-xl font-bold text-dark">Already on the free plan? You are grandfathered in.</h2>
            </div>
            <p class="text-slate-600 leading-relaxed">
              RepairKeeper retired the free-forever plan for new signups, but every shop that was already on it keeps it — indefinitely. You retain your 25 tickets per month, 1 team member, and the core feature set you signed up with. No action required. Your account continues as normal.
            </p>
            <p class="mt-3 text-slate-600 leading-relaxed">
              When you are ready to scale — more tickets, team members, inventory management, or the repair wiki — you can upgrade from your dashboard in a minute. All your data carries over.
            </p>
            <div class="mt-5">
              <a href="https://app.repairkeeper.co.uk" class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:text-primary-dark">
                Sign in to your account
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Who the trial is for -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="Who the 14-day trial is for"
            subtitle="The trial works for repair businesses at any stage — from first-week solo technicians to established multi-tech shops."
          />
        </div>
        <div class="reveal stagger grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { icon: "smartphone", title: "Solo technicians", desc: "Running a one-person phone or computer repair operation? Trial the Solo plan — 75 tickets/mo at £12/mo covers most small shops, three times what the old free plan did." },
            { icon: "star", title: "New repair businesses", desc: "Just getting started? Trial the plan that fits your projected volume. You have two weeks to load up customers, build your workflow, and confirm the fit." },
            { icon: "tool", title: "Evaluating software", desc: "Comparing RepairKeeper against RepairDesk, Repair Pilot, or RepairBook? Full product access for 14 days lets you properly stress-test a real workflow before switching." },
            { icon: "bar-chart", title: "Migrating from another tool", desc: "Import customers, set up statuses, and run your first week of repairs inside the trial. If it is not a better fit, cancel before day 14 — no charge, no follow-up." },
            { icon: "users", title: "Small teams", desc: "Trial Standard or Pro to test team permissions, audit logging, and inventory management with your actual staff and stock. No time-limited feature fences." },
            { icon: "pound", title: "Budget-conscious shops", desc: "Every pound matters. Paid plans start at £12/mo and the trial means you pay nothing while you decide — no commitment until day 15." },
          ].map((item) => (
            <div class="card-hover rounded-xl border border-slate-200 bg-white p-6">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name={item.icon} size={20} />
              </div>
              <h3 class="font-semibold text-dark">{item.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading title="Free trial questions" badge="FAQ" />
        </div>
        <div class="reveal stagger space-y-3">
          {[
            { q: "Does RepairKeeper offer free repair shop software?", a: "Every paid plan — Solo (£12/mo), Lite (£20/mo), Standard (£30/mo), and Pro (£55/mo) — starts with a 14-day free trial. A card is required at signup and you can cancel any time before day 14 to avoid being charged. Shops that were on the original free plan before it was retired remain grandfathered in." },
            { q: "Is the 14-day free trial really free?", a: "Yes. You pay nothing for 14 days. A payment card is required at signup so billing can begin automatically on day 15 if you continue. Cancel any time during the trial and no charge is taken." },
            { q: "Why was the free forever plan retired for new signups?", a: "The old free plan drew signups that never became active shops, which diluted product focus. A 14-day trial on paid plans gives new shops full access to the feature set they will actually use — including the Solo plan at £12/mo with 75 tickets per month, which is larger than the old free plan's 25-ticket cap." },
            { q: "I already have a free account — do I lose it?", a: "No. Every shop that was on the free plan before it was retired is grandfathered in and keeps it indefinitely, with the same 25 tickets per month, 1 team member, and core feature set. You can upgrade to a paid plan any time if your shop outgrows it." },
            { q: "What happens at the end of the trial?", a: "On day 15, the card you provided at signup is charged for your first month (or year, if you chose yearly billing). Cancel from your dashboard at any point during the trial and no charge is taken." },
            { q: "Can I switch plans during the trial?", a: "Yes. You can switch between Solo, Lite, Standard, and Pro during the trial to find the best fit. The trial window does not reset when you switch." },
            { q: "What is the cheapest paid plan?", a: "Solo is £12/mo and includes 75 tickets per month — three times the old free plan's allowance — with core ticketing, invoicing, customer tracking pages, digital signatures, and auto-status automation. It starts with a 14-day free trial." },
            { q: "Is there a free trial for UK businesses specifically?", a: "Yes. RepairKeeper is built in the UK, priced in GBP, and handles UK VAT correctly. The 14-day trial is available to repair businesses worldwide, with UK shops being the primary audience." },
          ].map((item) => (
            <details class="group rounded-xl border border-slate-200 bg-white transition-all hover:border-primary/30">
              <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-left">
                <span class="pr-4 text-base font-semibold text-dark group-open:text-primary">{item.q}</span>
                <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180 group-open:text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
              </summary>
              <div class="px-6 pb-4">
                <p class="text-sm leading-relaxed text-slate-600">{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden bg-dark py-20 sm:py-28">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-primary/20 blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-accent/20 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <div class="reveal">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Start your 14-day free trial today
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-400">
            Sign up in under a minute, start creating tickets immediately, and pay nothing for 14 days. Cancel any time before day 14 to avoid any charge.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href="https://app.repairkeeper.co.uk/register" class="inline-flex items-center gap-2 rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-light hover:shadow-xl hover:shadow-primary/30">
              Start 14-day free trial
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
            <a href="/pricing" class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-transparent px-6 py-3.5 text-base font-semibold text-white transition-all hover:border-slate-400">
              View All Plans
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Card required at signup. Cancel before day 14 to avoid any charge. <a href="/pricing" class="text-primary-light hover:underline">See all plans</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
