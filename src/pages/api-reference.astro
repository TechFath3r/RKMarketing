---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://repairkeeper.co.uk" },
    { "@type": "ListItem", position: 2, name: "API Reference", item: "https://repairkeeper.co.uk/api-reference" },
  ],
};
---

<BaseLayout
  title="API Reference — RepairKeeper"
  description="Full REST API documentation for RepairKeeper. Manage tickets, customers, invoices, inventory, and webhooks programmatically."
>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="hero-gradient relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-20">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-primary/5 blur-3xl animate-pulse-glow"></div>
        <div class="absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-accent/5 blur-3xl animate-pulse-glow" style="animation-delay: 1.5s;"></div>
      </div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
        <div class="animate-fade-in">
          <span class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-sm font-medium text-primary">
            Developer Docs
          </span>
        </div>

        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-dark sm:text-5xl lg:text-6xl animate-fade-up" style="animation-delay: 0.1s;">
          API Reference
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600 animate-fade-up" style="animation-delay: 0.2s;">
          Everything you need to connect RepairKeeper to your tools, agents, and automations.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4 animate-fade-up" style="animation-delay: 0.3s;">
          <a
            href="/openapi.yaml"
            download
            class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-dark shadow-sm transition-all hover:border-slate-300 hover:shadow-md"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 18h16"/></svg>
            Download OpenAPI Spec
          </a>
          <a
            href="https://app.repairkeeper.co.uk/dashboard/api-keys"
            class="inline-flex items-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-primary-dark hover:shadow-md"
          >
            Get API Key
          </a>
        </div>
      </div>
    </section>

    <!-- Scalar API Reference -->
    <div class="w-full" style="min-height: 80vh;">
      <script
        id="api-reference"
        data-url="/openapi.yaml"
        data-configuration={JSON.stringify({
          theme: "default",
          layout: "modern",
          darkMode: false,
          metaData: {
            title: "RepairKeeper API Reference",
          },
          customCss: `
            .scalar-app { --scalar-color-1: #B70000; }
          `,
        })}
      ></script>
      <script src="https://cdn.jsdelivr.net/npm/@scalar/api-reference"></script>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
