---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Icon from "@components/Icon.astro";
import SectionHeading from "@components/SectionHeading.astro";
import FeatureDetail from "@components/FeatureDetail.astro";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://repairkeeper.co.uk" },
    { "@type": "ListItem", position: 2, name: "Computer Repair Shop Software", item: "https://repairkeeper.co.uk/computer-repair-shop-software" },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is RepairKeeper suitable for computer and laptop repair shops?",
      acceptedAnswer: { "@type": "Answer", text: "Yes. RepairKeeper is built for repair businesses of all kinds — including computer repair shops, laptop service centres, and IT support providers. Features like multi-device tickets, asset tracking, detailed diagnosis workflows, and subcontractor handoff are designed for the longer, more complex repairs that computer shops deal with daily." },
    },
    {
      "@type": "Question",
      name: "Can I track multiple laptops on a single ticket?",
      acceptedAnswer: { "@type": "Answer", text: "Yes. RepairKeeper supports multi-device tickets — a business client can drop off five laptops on one ticket, and each device is tracked independently with its own status, diagnosis, parts, and cost. The ticket status always reflects the most behind device." },
    },
    {
      "@type": "Question",
      name: "Does RepairKeeper handle subcontractor and specialist repairs?",
      acceptedAnswer: { "@type": "Answer", text: "Yes. You can track subcontractor details, courier information, and return status per device. This is ideal for sending board-level repairs or data recovery jobs to specialist partners while keeping the customer informed." },
    },
    {
      "@type": "Question",
      name: "Can I track serial numbers and customer assets across repeat repairs?",
      acceptedAnswer: { "@type": "Answer", text: "Yes. The Asset Registry lets you register customer-owned devices with serial numbers, link them to wiki device types, and see their full repair history. When a repeat customer brings their laptop back, you can pull up every previous repair instantly." },
    },
    {
      "@type": "Question",
      name: "Is there a free trial for small computer repair shops?",
      acceptedAnswer: { "@type": "Answer", text: "Yes. Every paid plan starts with a 14-day free trial — including Solo at £12/month with 75 tickets, ideal for a one-person computer repair shop. Card details are required at signup, but you aren't charged until day 14 and you can cancel any time before then." },
    },
  ],
};
---

<BaseLayout
  title="Computer Repair Shop Software — Built for PC & Laptop Repair | RepairKeeper"
  description="Management software for computer repair shops. Multi-device tickets, diagnosis workflows, subcontractor tracking, and invoicing. 14-day free trial. UK-based."
>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="hero-gradient relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-20">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-primary/5 blur-3xl animate-pulse-glow"></div>
        <div class="absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-accent/5 blur-3xl animate-pulse-glow" style="animation-delay: 1.5s;"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary animate-fade-in">
          For Computer Repair Shops
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-dark sm:text-5xl animate-fade-up" style="animation-delay: 0.15s;">
          Software built for <span class="gradient-text">computer repair shops</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 animate-fade-up" style="animation-delay: 0.3s;">
          Board-level diagnostics, data recovery, OS reinstalls, hardware upgrades — RepairKeeper handles the full workflow from intake to collection. Built for the complexity that computer repair demands.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4 animate-fade-up" style="animation-delay: 0.45s;">
          <a href="https://app.repairkeeper.co.uk/register" class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-base font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-dark hover:shadow-xl hover:shadow-primary/30">
            Start 14-day free trial
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a href="/pricing" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-700 transition-all hover:border-primary/30 hover:text-primary">
            View Pricing
          </a>
        </div>
        <p class="mt-4 text-sm text-slate-500 animate-fade-up" style="animation-delay: 0.55s;">14-day free trial on every plan. Card required, cancel before day 14.</p>
      </div>
    </section>

    <!-- Why computer repair shops need this -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="Everything a computer repair shop needs"
            subtitle="From the moment a customer drops off a laptop with a failed hard drive to the moment they collect it fully restored — RepairKeeper handles every step."
          />
        </div>
        <div class="reveal stagger grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { icon: "ticket", title: "Multi-device tickets", desc: "Business client drops off five laptops? One ticket, five devices. Each tracked independently with its own status, diagnosis, and parts." },
            { icon: "clipboard-list", title: "Detailed diagnosis workflow", desc: "Record multiple potential faults per device. Run diagnostics, document findings, and get customer approval before starting work." },
            { icon: "zap", title: "Auto-status updates", desc: "Order an SSD? The device moves to 'Awaiting Parts' automatically. Parts arrive? It advances again. No manual status changes needed." },
            { icon: "send", title: "Subcontractor tracking", desc: "Send board-level repairs or data recovery to a specialist? Track subcontractor details, courier info, and return status per device." },
            { icon: "inventory", title: "Laptop parts inventory", desc: "Track screens, keyboards, batteries, SSDs, RAM, and chargers across locations. Know what's in stock before you quote a turnaround." },
            { icon: "tag", title: "Asset registry", desc: "Register customer devices with serial numbers. See the full repair history for any machine — essential for corporate fleet management." },
            { icon: "shield", title: "Digital signatures", desc: "Capture intake and collection signatures on screen. Document device condition and agreed work — vital for high-value laptop repairs." },
            { icon: "calendar", title: "Repair scheduling", desc: "Set repair-due-by deadlines, track drop-off and collection dates. Overdue alerts ensure no laptop sits forgotten on your bench." },
            { icon: "team", title: "Team assignment", desc: "Assign devices to technicians by specialty — hardware to one, data recovery to another, software rebuilds to a third." },
          ].map((item) => (
            <div class="card-hover rounded-xl border border-slate-200 bg-white p-6">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name={item.icon} size={20} />
              </div>
              <h3 class="font-semibold text-dark">{item.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Multi-device + diagnosis detail -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <FeatureDetail
            title="Multi-device tickets built for complex repairs"
            subtitle="Computer repair shops don't deal with one device at a time. A business client drops off a batch of laptops. A customer brings in a desktop and a monitor. RepairKeeper lets you add multiple devices to a single ticket — each with its own diagnosis, status, parts, and cost — so nothing gets lost in the shuffle."
            badge="Key Differentiator"
            items={[
              { icon: "ticket", title: "Independent device tracking", description: "Five laptops on one ticket? Each device has its own status pipeline, parts list, and diagnosis notes. No more juggling separate tickets." },
              { icon: "zap", title: "Intelligent auto-status", description: "When you mark a part as ordered, the device moves to 'Awaiting Parts'. When parts arrive and are allocated, it advances automatically." },
              { icon: "clipboard-list", title: "Diagnosis per device", description: "Run diagnostics on each machine separately — document hardware faults, software issues, and data recovery needs. Share findings with the customer for approval." },
              { icon: "send", title: "Subcontractor handoff", description: "Need to send a motherboard to a specialist or a drive to a data recovery lab? Track subcontractor details, courier info, and return status per device." },
            ]}
          >
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg">
              <div class="mb-4 flex items-center justify-between">
                <span class="text-sm font-semibold text-dark">Ticket RK-0132</span>
                <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">In Progress</span>
              </div>
              <div class="space-y-3">
                <div class="rounded-lg border border-slate-100 p-3">
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-dark">Dell Latitude 5540</span>
                    <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">In Repair</span>
                  </div>
                  <p class="mt-1 text-xs text-slate-500">SSD upgrade + Windows reinstall — parts allocated</p>
                </div>
                <div class="rounded-lg border border-slate-100 p-3">
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-dark">Lenovo ThinkPad T14</span>
                    <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700">Awaiting Parts</span>
                  </div>
                  <p class="mt-1 text-xs text-slate-500">Keyboard replacement — part on order from supplier</p>
                </div>
                <div class="rounded-lg border border-slate-100 p-3">
                  <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-dark">HP EliteBook 840</span>
                    <span class="rounded-full bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-700">With Subcontractor</span>
                  </div>
                  <p class="mt-1 text-xs text-slate-500">Board-level repair — sent to specialist via DPD</p>
                </div>
              </div>
              <p class="mt-3 text-xs text-slate-400">Ticket status reflects the most behind device</p>
            </div>
          </FeatureDetail>
        </div>
      </div>
    </section>

    <!-- UK-specific section -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="mx-auto max-w-3xl text-center">
            <span class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary">Built in the UK</span>
            <h2 class="text-3xl font-bold tracking-tight text-dark sm:text-4xl">
              Designed for UK computer repair shops
            </h2>
            <p class="mt-4 text-lg text-slate-600">
              RepairKeeper is built by a UK developer, priced in GBP, and includes VAT support out of the box. Most repair shop software is US-focused and built around mobile-only workflows. RepairKeeper understands that UK computer repair shops handle everything from consumer laptops to corporate fleet maintenance — and the software reflects that complexity.
            </p>
          </div>
        </div>
        <div class="reveal stagger mt-12 grid gap-6 sm:grid-cols-3">
          {[
            { icon: "pound", title: "GBP pricing & invoicing", desc: "Prices, invoices, and quotes all in pounds sterling. VAT registration and configurable rates included." },
            { icon: "globe", title: "UK-hosted SaaS", desc: "Web-based — works on any device. No US-centric assumptions or irrelevant features cluttering your workflow." },
            { icon: "shield", title: "GDPR-aware", desc: "Customer data handling, per-customer email preferences, and audit logging to help you stay compliant — important when handling business client data." },
          ].map((item) => (
            <div class="card-hover rounded-xl border border-slate-200 bg-white p-6 text-center">
              <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name={item.icon} size={20} />
              </div>
              <h3 class="font-semibold text-dark">{item.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Related pages -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading title="Explore more features" />
        </div>
        <div class="reveal stagger grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { icon: "ticket", title: "Repair ticket software", desc: "Deep dive into RepairKeeper's ticket management system — statuses, signatures, scheduling, and more.", href: "/repair-ticket-software" },
            { icon: "customers", title: "Repair shop CRM", desc: "Manage customers, track repair history, detect duplicates, and automate notifications.", href: "/repair-shop-crm" },
            { icon: "inventory", title: "Repair shop inventory", desc: "Track parts across multiple locations, manage suppliers, and automate stock allocation to tickets.", href: "/repair-shop-inventory-software" },
          ].map((item) => (
            <a href={item.href} class="card-hover block rounded-xl border border-slate-200 bg-white p-6 transition-colors hover:border-primary/30">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name={item.icon} size={20} />
              </div>
              <h3 class="font-semibold text-dark">{item.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{item.desc}</p>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary">Learn more <Icon name="arrow-right" size={14} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading title="Computer repair shop questions" badge="FAQ" />
        </div>
        <div class="reveal stagger space-y-3">
          {[
            { q: "Is RepairKeeper suitable for computer and laptop repair shops?", a: "Yes. RepairKeeper is built for repair businesses of all kinds — including computer repair shops, laptop service centres, and IT support providers. Features like multi-device tickets, asset tracking, detailed diagnosis workflows, and subcontractor handoff are designed for the longer, more complex repairs that computer shops deal with daily." },
            { q: "Can I track multiple laptops on a single ticket?", a: "Yes. RepairKeeper supports multi-device tickets — a business client can drop off five laptops on one ticket, and each device is tracked independently with its own status, diagnosis, parts, and cost. The ticket status always reflects the most behind device." },
            { q: "Does RepairKeeper handle subcontractor and specialist repairs?", a: "Yes. You can track subcontractor details, courier information, and return status per device. This is ideal for sending board-level repairs or data recovery jobs to specialist partners while keeping the customer informed." },
            { q: "Can I track serial numbers and customer assets across repeat repairs?", a: "Yes. The Asset Registry lets you register customer-owned devices with serial numbers, link them to wiki device types, and see their full repair history. When a repeat customer brings their laptop back, you can pull up every previous repair instantly." },
            { q: "Is there a free trial for small computer repair shops?", a: "Yes. Every paid plan starts with a 14-day free trial — including Solo at £12/month with 75 tickets, ideal for a one-person computer repair shop. Card details are required at signup, but you aren't charged until day 14 and you can cancel any time before then." },
          ].map((item) => (
            <details class="group rounded-xl border border-slate-200 bg-white transition-all hover:border-primary/30">
              <summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-left">
                <span class="pr-4 text-base font-semibold text-dark group-open:text-primary">{item.q}</span>
                <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180 group-open:text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
              </summary>
              <div class="px-6 pb-4">
                <p class="text-sm leading-relaxed text-slate-600">{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden bg-dark py-20 sm:py-28">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-primary/20 blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-accent/20 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <div class="reveal">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Ready to run your computer repair shop properly?
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-400">
            Join computer repair shops across the UK already using RepairKeeper to manage tickets, track parts, and serve customers. Start your 14-day free trial — cancel any time before day 14 and you won't be charged.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href="https://app.repairkeeper.co.uk/register" class="inline-flex items-center gap-2 rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-light hover:shadow-xl hover:shadow-primary/30">
              Start 14-day free trial
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Card required &mdash; cancel any time before day 14 and you won't be charged. <a href="/pricing" class="text-primary-light hover:underline">See pricing</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
