---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Hero from "@components/Hero.astro";
import HowItWorks from "@components/HowItWorks.astro";
import FeatureOverview from "@components/FeatureOverview.astro";
import MultiDeviceTickets from "@components/MultiDeviceTickets.astro";
import QuotingInvoicing from "@components/QuotingInvoicing.astro";
import CustomerExperience from "@components/CustomerExperience.astro";
import InventoryManagement from "@components/InventoryManagement.astro";
import TradeInRefurbishment from "@components/TradeInRefurbishment.astro";
import WikiKnowledgeBase from "@components/WikiKnowledgeBase.astro";
import TeamPermissions from "@components/TeamPermissions.astro";
import Pricing from "@components/Pricing.astro";
import Differentiators from "@components/Differentiators.astro";
import FAQ from "@components/FAQ.astro";
import CTABanner from "@components/CTABanner.astro";
import Footer from "@components/Footer.astro";
---

<BaseLayout
  title="RepairKeeper — Repair Shop Management Software for Phone, Electronics & Computer Repairs"
  description="All-in-one repair shop management software. Multi-device tickets, intelligent auto-status, quoting, invoicing, inventory, trade-in & refurbishment, online booking, customer tracking, and team management. Free plan available. Built for UK repair businesses."
>
  <Header />
  <main id="main-content">
    <Hero />
    <HowItWorks />
    <FeatureOverview />
    <MultiDeviceTickets />
    <QuotingInvoicing />
    <CustomerExperience />
    <InventoryManagement />
    <TradeInRefurbishment />
    <WikiKnowledgeBase />
    <TeamPermissions />
    <Pricing />
    <Differentiators />
    <FAQ />
    <CTABanner />
  </main>
  <Footer />
</BaseLayout>
