---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Icon from "@components/Icon.astro";
import SectionHeading from "@components/SectionHeading.astro";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://repairkeeper.co.uk" },
    { "@type": "ListItem", position: 2, name: "RepairKeeper vs RepairShopr", item: "https://repairkeeper.co.uk/repairkeeper-vs-repairshopr" },
  ],
};

const comparisonFeatures = [
  { feature: "Multi-device tickets", rk: true, rs: false },
  { feature: "Auto-status engine", rk: true, rs: false },
  { feature: "Repair wiki / knowledge base", rk: true, rs: false },
  { feature: "Customer tracking page", rk: true, rs: "limited" },
  { feature: "Online payments (Stripe)", rk: true, rs: "limited" },
  { feature: "RMM / PSA integration", rk: false, rs: true },
  { feature: "Inventory management", rk: true, rs: true },
  { feature: "Team roles & permissions", rk: true, rs: true },
  { feature: "14-day free trial", rk: true, rs: false },
  { feature: "UK-based / GBP pricing", rk: true, rs: false },
  { feature: "Trade-in & refurbishment", rk: true, rs: false },
  { feature: "Digital signatures", rk: true, rs: false },
];
---

<BaseLayout
  title="RepairKeeper vs RepairShopr (Syncro) — Honest Comparison (2026)"
  description="Comparing RepairKeeper and RepairShopr/Syncro for repair shop management. Features, pricing, and honest differences for UK repair businesses."
>
  <Header />
  <main id="main-content">
    <!-- Hero -->
    <section class="hero-gradient relative overflow-hidden pt-28 pb-16 sm:pt-36 sm:pb-20">
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-primary/5 blur-3xl animate-pulse-glow"></div>
        <div class="absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-accent/5 blur-3xl animate-pulse-glow" style="animation-delay: 1.5s;"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <span class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary animate-fade-in">
          Comparison
        </span>
        <h1 class="text-4xl font-extrabold tracking-tight text-dark sm:text-5xl animate-fade-up" style="animation-delay: 0.15s;">
          RepairKeeper vs RepairShopr <span class="gradient-text">(Syncro)</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 animate-fade-up" style="animation-delay: 0.3s;">
          An honest, side-by-side comparison of RepairKeeper and RepairShopr/Syncro for repair shop management. Which platform is the better fit for your UK repair business in 2026?
        </p>
      </div>
    </section>

    <!-- Intro -->
    <section class="py-16 sm:py-20 bg-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <div class="prose prose-slate max-w-none">
            <p class="text-lg leading-relaxed text-slate-600">
              RepairShopr was once one of the most popular repair shop management tools on the market. In recent years it merged with <strong>Syncro</strong>, and the combined platform has shifted its development focus towards the <strong>MSP (managed service provider) and IT services market</strong>. Syncro now positions itself primarily as a PSA and RMM platform for IT businesses, with repair shop features taking a back seat.
            </p>
            <p class="mt-4 text-lg leading-relaxed text-slate-600">
              <strong>RepairKeeper</strong>, by contrast, is <strong>purpose-built for independent repair shops</strong> — phone repair, electronics, computers, and similar trades. It is designed from the ground up around the repair lifecycle, not adapted from a helpdesk or IT management tool. If you are searching for a <strong>RepairShopr alternative</strong> or a <strong>Syncro alternative</strong> that is focused entirely on repair businesses, this comparison will help you decide.
            </p>
            <p class="mt-4 text-lg leading-relaxed text-slate-600">
              We aim to be fair and transparent. RepairShopr/Syncro has a longer track record and genuine strengths. RepairKeeper is newer but built with a singular focus on what repair shops actually need day to day.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature Comparison Table -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="Feature comparison"
            subtitle="A side-by-side look at the features that matter for UK repair shops."
          />
        </div>
        <div class="reveal overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
          <table class="w-full min-w-[480px] text-sm">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50">
                <th class="px-4 py-3.5 text-left font-semibold text-dark">Feature</th>
                <th class="px-3 py-3.5 text-center font-semibold text-primary">RepairKeeper</th>
                <th class="px-3 py-3.5 text-center font-semibold text-dark">RepairShopr / Syncro</th>
              </tr>
            </thead>
            <tbody>
              {comparisonFeatures.map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                  <td class="px-4 py-3 font-medium text-dark">{row.feature}</td>
                  <td class="px-3 py-3 text-center">
                    {row.rk === true ? (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                        <Icon name="check" size={14} />
                      </span>
                    ) : row.rk === "limited" ? (
                      <span class="inline-block rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">Limited</span>
                    ) : (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                        <Icon name="x" size={14} />
                      </span>
                    )}
                  </td>
                  <td class="px-3 py-3 text-center">
                    {row.rs === true ? (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                        <Icon name="check" size={14} />
                      </span>
                    ) : row.rs === "limited" ? (
                      <span class="inline-block rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">Limited</span>
                    ) : (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                        <Icon name="x" size={14} />
                      </span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-center text-xs text-slate-400">Feature availability based on publicly available information as of March 2026. Contact individual providers for the latest details.</p>
      </div>
    </section>

    <!-- Where RepairShopr/Syncro excels -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="Where RepairShopr / Syncro excels"
            subtitle="Giving credit where it is due — RepairShopr has genuine strengths."
            badge="Fair comparison"
          />
        </div>
        <div class="reveal stagger grid gap-6 sm:grid-cols-2">
          {[
            { icon: "globe", title: "Brand recognition", desc: "RepairShopr has been in the market for over a decade. It built a strong name in the repair industry before its shift towards MSP/IT services, and Syncro continues to have an established user base." },
            { icon: "tool", title: "RMM & PSA integration", desc: "If your business does both repairs and managed IT services, Syncro offers built-in remote monitoring and management (RMM) and professional services automation (PSA) tools that RepairKeeper does not." },
            { icon: "users", title: "Established community", desc: "With years of community forums, knowledge articles, and third-party integrations, RepairShopr/Syncro has a mature ecosystem that comes with a long-standing platform." },
            { icon: "customers", title: "CRM capabilities", desc: "Syncro offers solid customer relationship management features, including communication tracking and marketing tools geared towards IT service businesses." },
          ].map((item) => (
            <div class="card-hover rounded-xl border border-slate-200 bg-white p-6">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                <Icon name={item.icon} size={20} />
              </div>
              <h3 class="font-semibold text-dark">{item.title}</h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Where RepairKeeper excels -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="Where RepairKeeper excels"
            subtitle="Built from scratch for repair shops — not adapted from a helpdesk."
            badge="Purpose-built"
          />
        </div>
        <div class="reveal stagger grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { icon: "ticket", title: "Multi-device tickets", desc: "A single ticket can hold multiple devices, each with its own status and parts. When a customer drops off a phone and a tablet, you track them independently in one ticket.", link: "/repair-ticket-software" },
            { icon: "zap", title: "Intelligent auto-status", desc: "Device statuses advance automatically based on parts workflow. The ticket status derives from the most behind device — zero manual status updates needed.", link: "/repair-ticket-software" },
            { icon: "wiki", title: "Repair wiki & knowledge base", desc: "Build a searchable database of devices, parts, faults, and repair guides. Contribute to a shared global knowledge base or keep entries private to your shop.", link: null },
            { icon: "tracking", title: "Customer self-service", desc: "Customers get a unique tracking link to see real-time repair progress, view quotes, and pay invoices online via Stripe — all without calling the shop.", link: null },
            { icon: "inventory", title: "Smart inventory management", desc: "Track stock across multiple locations with automatic allocation when parts are added to tickets. One-click allocation when stock arrives, plus low-stock alerts.", link: "/repair-shop-inventory-software" },
            { icon: "pound", title: "UK-built, GBP pricing", desc: "RepairKeeper is built in the UK, priced in GBP, and handles VAT natively. No currency conversion or US-centric tax assumptions to work around.", link: "/pricing" },
            { icon: "shield", title: "Granular permissions & audit trail", desc: "11 permission flags per team member, full audit logging with before/after diffs, and complete user attribution on every change.", link: null },
            { icon: "camera", title: "Digital signatures", desc: "Capture intake and collection signatures on-screen. The booking-in workflow automatically advances device statuses when a signature is captured.", link: null },
            { icon: "star", title: "14-day free trial on every plan", desc: "Every paid plan — from Solo at £12/month up to Pro — starts with a 14-day free trial. Card required at signup, cancel any time before day 14 and you won't be charged.", link: "/pricing" },
          ].map((item) => (
            <div class="card-hover rounded-xl border border-slate-200 bg-white p-5">
              <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name={item.icon} size={20} />
              </div>
              <h3 class="text-sm font-semibold text-dark">{item.title}</h3>
              <p class="mt-1 text-xs text-slate-600 leading-relaxed">{item.desc}</p>
              {item.link && (
                <a href={item.link} class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-primary hover:underline">
                  Learn more
                  <Icon name="arrow-right" size={12} />
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Things to consider -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="Things to consider"
            subtitle="An honest look at the trade-offs with each platform."
          />
        </div>
        <div class="reveal stagger grid gap-8 sm:grid-cols-2">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
            <h3 class="flex items-center gap-2 text-lg font-bold text-dark">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                <Icon name="tool" size={18} />
              </div>
              RepairShopr / Syncro
            </h3>
            <ul class="mt-4 space-y-2.5">
              {[
                "Development focus has shifted towards the MSP and IT services market",
                "Less repair-shop-specific innovation in recent updates",
                "Pricing starts at ~$139/mo USD — significantly higher than many alternatives",
                "US-centric platform with USD pricing and American tax defaults",
                "Feature set can feel overwhelming if you only need repair management",
              ].map((item) => (
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 8v4" /><path d="M12 16h.01" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-2xl border border-primary/40 ring-2 ring-primary/10 bg-white p-6 sm:p-8">
            <h3 class="flex items-center gap-2 text-lg font-bold text-dark">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <Icon name="star" size={18} />
              </div>
              RepairKeeper
            </h3>
            <ul class="mt-4 space-y-2.5">
              {[
                "Newer to market — does not have the decade-long track record of RepairShopr",
                "No RMM or PSA features (not designed for MSP/IT service management)",
                "Mobile app not yet available (fully responsive web app works on all devices)",
                "Smaller community and ecosystem compared to the established Syncro user base",
              ].map((item) => (
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 8v4" /><path d="M12 16h.01" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Comparison -->
    <section class="py-20 sm:py-28 bg-slate-50">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="Pricing comparison"
            subtitle="RepairKeeper offers a 14-day free trial on every plan and significantly lower price points than Syncro."
          />
        </div>
        <div class="reveal stagger grid gap-6 sm:grid-cols-2">
          <div class="rounded-2xl border border-primary/40 ring-2 ring-primary/10 bg-white p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <Icon name="star" size={22} />
              </div>
              <h3 class="text-xl font-bold text-dark">RepairKeeper</h3>
            </div>
            <ul class="space-y-3">
              {[
                { plan: "Solo", price: "£12/mo", detail: "75 tickets/mo, 1 user" },
                { plan: "Lite", price: "£20/mo", detail: "150 tickets/mo, 1 user" },
                { plan: "Standard", price: "£30/mo", detail: "Unlimited tickets, 5 users" },
                { plan: "Pro", price: "£55/mo", detail: "Unlimited tickets, 15 users" },
              ].map((item) => (
                <li class="flex items-center justify-between rounded-lg bg-slate-50 px-4 py-2.5">
                  <div>
                    <span class="font-semibold text-dark text-sm">{item.plan}</span>
                    <span class="ml-2 text-xs text-slate-500">{item.detail}</span>
                  </div>
                  <span class="text-sm font-bold text-primary">{item.price}</span>
                </li>
              ))}
            </ul>
            <a href="/pricing" class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline">
              View full pricing details
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
            <div class="flex items-center gap-3 mb-4">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100 text-slate-500">
                <Icon name="tool" size={22} />
              </div>
              <h3 class="text-xl font-bold text-dark">Syncro (RepairShopr)</h3>
            </div>
            <ul class="space-y-3">
              {[
                { plan: "Syncro", price: "~$139/mo USD", detail: "Per user pricing" },
              ].map((item) => (
                <li class="flex items-center justify-between rounded-lg bg-slate-50 px-4 py-2.5">
                  <div>
                    <span class="font-semibold text-dark text-sm">{item.plan}</span>
                    <span class="ml-2 text-xs text-slate-500">{item.detail}</span>
                  </div>
                  <span class="text-sm font-bold text-slate-600">{item.price}</span>
                </li>
              ))}
            </ul>
            <p class="mt-4 text-xs text-slate-500">
              Syncro pricing is in USD. There is no free trial or lower-cost tier specifically for repair-only businesses. Pricing includes RMM and PSA tools which may not be needed for standalone repair shops.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Who should choose which -->
    <section class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="reveal">
          <SectionHeading
            title="Which is right for you?"
            subtitle="The best choice depends on the type of business you run."
          />
        </div>
        <div class="reveal stagger grid gap-6 sm:grid-cols-2">
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <h3 class="mb-3 font-bold text-dark">Choose RepairShopr / Syncro if you:</h3>
            <ul class="space-y-2">
              {[
                "Run a managed IT services (MSP) business alongside repairs",
                "Need RMM and PSA tools integrated into your workflow",
                "Are already invested in the Syncro ecosystem",
                "Prefer working with a longer-established platform",
              ].map((item) => (
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-xl border border-primary/40 ring-2 ring-primary/10 bg-white p-6">
            <h3 class="mb-3 font-bold text-dark">Choose RepairKeeper if you:</h3>
            <ul class="space-y-2">
              {[
                "Run a dedicated repair shop (phones, electronics, computers)",
                "Want multi-device tickets with automatic status tracking",
                "Need a platform purpose-built for repair workflows",
                "Prefer UK-based software with GBP pricing and VAT support",
                "Want a 14-day free trial on every plan to test before committing",
                "Value a shared repair wiki and knowledge base",
              ].map((item) => (
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden bg-dark py-20 sm:py-28">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-primary/20 blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 h-96 w-96 rounded-full bg-accent/20 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <div class="reveal">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Try RepairKeeper free for 14 days
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-400">
            See why UK repair shops are switching to RepairKeeper. Start a 14-day free trial on any plan — card required at signup, cancel before day 14 and you won't be charged.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href="https://app.repairkeeper.co.uk/register" class="inline-flex items-center gap-2 rounded-lg bg-primary px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-primary/25 transition-all hover:bg-primary-light hover:shadow-xl hover:shadow-primary/30">
              Start 14-day free trial
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
            <a href="/pricing" class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-transparent px-6 py-3.5 text-base font-semibold text-white transition-all hover:border-slate-400">
              View Pricing
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Card required &mdash; cancel any time before day 14 and you won't be charged. <a href="/pricing" class="text-primary-light hover:underline">See all plans</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</BaseLayout>
